# AI Studio Runtime Environment Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Optional outside AI Studio)
# In AI Studio, configuration is loaded automatically from firebase-applet-config.json.
# If running independently in custom environments, you can also define these:
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# Admin User Email
VITE_ADMIN_EMAIL="wantawachjz@gmail.com"
