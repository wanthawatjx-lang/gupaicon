# ==============================================================================
# ENVIRONMENT TEMPLATE FOR PUBLIC REPOSITORY
# WARNING: NEVER COMMIT ACTUAL KEYS OR SECRETS TO A PUBLIC GIT REPOSITORY!
# Copy this file to '.env' (which is ignored by git) and set your value.
# ==============================================================================

# Server-Side Gemini API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# Application Host URL (optional, defaults to http://localhost:3000)
APP_URL="http://localhost:3000"
