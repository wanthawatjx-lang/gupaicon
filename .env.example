# ==============================================================================
# ENVIRONMENT TEMPLATE FOR PUBLIC REPOSITORY
# WARNING: NEVER COMMIT ACTUAL KEYS OR SECRETS TO A PUBLIC GIT REPOSITORY!
# Copy this file to '.env' (which is ignored by git) and set your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Gemini API Keys (Multi-Key Rotation & Rate-Limit Resilience)
# ------------------------------------------------------------------------------
# geminiClient.js automatically rotates keys when an HTTP 429 (Rate Limit) occurs.
# Provide multiple API keys to increase throughput and avoid rate-limiting interruptions.
GEMINI_API_KEY_1="AIzaSyYourFirstGeminiApiKeyHere"
GEMINI_API_KEY_2="AIzaSyYourSecondGeminiApiKeyHere"
GEMINI_API_KEY_3="AIzaSyYourThirdGeminiApiKeyHere"

# Single/fallback Gemini API key (optional if GEMINI_API_KEY_1 is provided)
GEMINI_API_KEY=""

# Application Host URL (e.g. http://localhost:3000 or production domain)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Firebase Client Configuration (Optional outside AI Studio)
# ------------------------------------------------------------------------------
# In AI Studio, Firebase config is loaded automatically from firebase-applet-config.json.
# If deploying independently to external hosting, specify these client-side variables:
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseWebApiKey"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# ------------------------------------------------------------------------------
# Admin Account Authorization
# ------------------------------------------------------------------------------
VITE_ADMIN_EMAIL="wanthawatjx@gmail.com"
