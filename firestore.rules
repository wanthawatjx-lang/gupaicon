rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'wantawachjz@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidStatus(status) {
      return status in ['not_open', 'available', 'low', 'sold_out', 'cancelled'];
    }

    // SPARK TIER NOTE ON GET/EXISTS:
    // This helper checks if an authenticated user owns an approved organizers/{uid} record
    // matching the target promoterId. It is strictly evaluated on individual write mutations
    // (create/update/delete) and NEVER on list or read queries, keeping reads minimal.
    function isOrganizerForPromoter(promoterId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/organizers/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizers/$(request.auth.uid)).data.promoterId == promoterId;
    }

    function isValidVenue(data) {
      return data.keys().hasAll(['name', 'lat', 'lng', 'address', 'igUrl', 'mapsUrl'])
        && data.keys().hasOnly(['name', 'lat', 'lng', 'address', 'igUrl', 'mapsUrl', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && (data.lat is int || data.lat is float)
        && (data.lng is int || data.lng is float)
        && data.address is string && data.address.size() >= 2 && data.address.size() <= 250
        && data.igUrl is string && data.igUrl.size() <= 300
        && data.mapsUrl is string && data.mapsUrl.size() <= 500
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidPromoter(data) {
      return data.keys().hasAll(['name', 'igUrl', 'verified'])
        && data.keys().hasOnly(['name', 'igUrl', 'verified', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.igUrl is string && data.igUrl.size() <= 300
        && data.verified is bool
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidEvent(data) {
      return data.keys().hasAll([
          'title', 'artists', 'venueId', 'promoterId', 'startAt',
          'priceText', 'genres', 'ticketUrl', 'igPostUrl', 'status',
          'statusUpdatedAt', 'statusSource'
        ])
        && data.keys().hasOnly([
          'title', 'artists', 'venueId', 'promoterId', 'startAt',
          'priceText', 'genres', 'ticketUrl', 'igPostUrl', 'posterUrl',
          'status', 'statusUpdatedAt', 'statusSource', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 150
        && data.artists is list && data.artists.size() >= 1 && data.artists.size() <= 30
        && data.venueId is string && isValidId(data.venueId)
        && data.promoterId is string && isValidId(data.promoterId)
        && data.startAt is timestamp
        && data.priceText is string && data.priceText.size() <= 80
        && data.genres is list && data.genres.size() <= 15
        && data.ticketUrl is string && data.ticketUrl.size() <= 500
        && data.igPostUrl is string && data.igPostUrl.size() <= 500
        && (!('posterUrl' in data) || (data.posterUrl is string && data.posterUrl.size() <= 1000))
        && data.status is string && isValidStatus(data.status)
        && data.statusUpdatedAt is timestamp
        && (data.statusSource in ['admin', 'organizer'])
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidOrganizerRequest(data) {
      return data.keys().hasAll(['promoterName', 'igUrl', 'contactEmail', 'note', 'status', 'createdAt'])
        && data.keys().hasOnly(['promoterName', 'igUrl', 'contactEmail', 'note', 'status', 'createdAt'])
        && data.promoterName is string && data.promoterName.size() >= 2 && data.promoterName.size() <= 100
        && data.igUrl is string && data.igUrl.size() <= 300
        && data.contactEmail is string && data.contactEmail.size() <= 150
        && data.note is string && data.note.size() <= 1000
        && (data.status in ['pending', 'approved', 'rejected'])
        && data.createdAt is timestamp;
    }

    // Venues Collection
    match /venues/{venueId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(venueId) && isValidVenue(incoming());
      allow update: if isAdmin() && isValidId(venueId) && isValidVenue(incoming());
      allow delete: if isAdmin() && isValidId(venueId);
    }

    // Promoters Collection
    match /promoters/{promoterId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(promoterId) && isValidPromoter(incoming());
      allow update: if isAdmin() && isValidId(promoterId) && isValidPromoter(incoming());
      allow delete: if isAdmin() && isValidId(promoterId);
    }

    // Events Collection & Reports Subcollection
    match /events/{eventId} {
      allow read: if true;

      // Create: Admin or verified Organizer for target promoterId
      allow create: if (isAdmin() && isValidId(eventId) && isValidEvent(incoming()))
        || (isOrganizerForPromoter(incoming().promoterId)
            && isValidId(eventId)
            && isValidEvent(incoming())
            && incoming().statusSource == 'organizer');

      // Update: Admin or verified Organizer (promoterId cannot be changed)
      allow update: if (isAdmin() && isValidId(eventId) && isValidEvent(incoming()))
        || (isOrganizerForPromoter(existing().promoterId)
            && incoming().promoterId == existing().promoterId
            && isValidId(eventId)
            && isValidEvent(incoming())
            && incoming().statusSource == 'organizer');

      // Delete: Admin or verified Organizer for the existing event's promoter
      allow delete: if (isAdmin() && isValidId(eventId))
        || (isOrganizerForPromoter(existing().promoterId) && isValidId(eventId));

      // Subcollection: Crowd-Reported Ticket Statuses
      match /reports/{uid} {
        allow read: if true;
        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && incoming().keys().hasAll(['status', 'createdAt'])
          && incoming().keys().hasOnly(['status', 'createdAt'])
          && (incoming().status in ['available', 'low', 'sold_out'])
          && incoming().createdAt == request.time;
        allow delete: if isSignedIn()
          && (request.auth.uid == uid || isAdmin());
      }
    }

    // Organizer Requests Collection (/organizerRequests/{uid})
    match /organizerRequests/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && isValidOrganizerRequest(incoming())
        && incoming().status == 'pending'
        && incoming().createdAt == request.time;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // Active Approved Organizers Collection (/organizers/{uid})
    match /organizers/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
