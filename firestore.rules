rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Single strictly authorized admin: wantawachjz@gmail.com with verified email
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'wantawachjz@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidStatus(status) {
      return status in ['available', 'low', 'soldout', 'notopen', 'cancelled', 'sold_out', 'not_open'];
    }

    function isValidVenue(data) {
      return data.keys().hasAll(['name', 'lat', 'lng', 'address', 'igUrl', 'mapsUrl'])
        && data.keys().hasOnly(['name', 'lat', 'lng', 'address', 'igUrl', 'mapsUrl', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && (data.lat is int || data.lat is float)
        && (data.lng is int || data.lng is float)
        && data.address is string && data.address.size() >= 2 && data.address.size() <= 250
        && data.igUrl is string && data.igUrl.size() <= 300
        && data.mapsUrl is string && data.mapsUrl.size() <= 500
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidPromoter(data) {
      return data.keys().hasAll(['name', 'verified'])
        && data.keys().hasOnly(['name', 'igUrl', 'verified', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && (!('igUrl' in data) || (data.igUrl is string && data.igUrl.size() <= 300))
        && data.verified is bool
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidEvent(data) {
      return data.keys().hasAll([
          'title', 'artists', 'venueId', 'startAt',
          'priceText', 'genres', 'status',
          'statusUpdatedAt', 'statusSource'
        ])
        && data.keys().hasOnly([
          'title', 'artists', 'venueId', 'promoterId', 'startAt',
          'priceText', 'genres', 'ticketUrl', 'igPostUrl', 'posterUrl',
          'status', 'statusUpdatedAt', 'statusSource', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.artists is list && data.artists.size() >= 1 && data.artists.size() <= 20
        && data.venueId is string && isValidId(data.venueId)
        && (!('promoterId' in data) || (data.promoterId is string && (data.promoterId == '' || isValidId(data.promoterId))))
        && data.startAt is timestamp
        && data.priceText is string && data.priceText.size() <= 60
        && data.genres is list && data.genres.size() <= 8
        && (!('ticketUrl' in data) || (data.ticketUrl is string && data.ticketUrl.size() <= 500))
        && (!('igPostUrl' in data) || (data.igPostUrl is string && data.igPostUrl.size() <= 500))
        && (!('posterUrl' in data) || (data.posterUrl is string && data.posterUrl.size() <= 1000))
        && data.status is string && isValidStatus(data.status)
        && data.statusUpdatedAt is timestamp
        && (data.statusSource in ['admin'])
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // 1. Venues Collection: Public read, Admin write
    match /venues/{venueId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(venueId) && isValidVenue(incoming());
      allow update: if isAdmin() && isValidId(venueId) && isValidVenue(incoming());
      allow delete: if isAdmin() && isValidId(venueId);
    }

    // 2. Promoters Collection: Public read, Admin write
    match /promoters/{promoterId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(promoterId) && isValidPromoter(incoming());
      allow update: if isAdmin() && isValidId(promoterId) && isValidPromoter(incoming());
      allow delete: if isAdmin() && isValidId(promoterId);
    }

    // 3. Events Collection: Public read, Admin write
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(eventId) && isValidEvent(incoming());
      allow update: if isAdmin() && isValidId(eventId) && isValidEvent(incoming());
      allow delete: if isAdmin() && isValidId(eventId);
    }
  }
}
