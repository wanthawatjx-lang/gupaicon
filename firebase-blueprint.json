{
  "entities": {
    "venue": {
      "title": "Venue",
      "description": "An indie / livehouse concert venue in Bangkok or Pathum Thani",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the venue",
          "minLength": 2,
          "maxLength": 100
        },
        "lat": {
          "type": "number",
          "description": "Latitude coordinate"
        },
        "lng": {
          "type": "number",
          "description": "Longitude coordinate"
        },
        "address": {
          "type": "string",
          "description": "Physical address or landmark area",
          "minLength": 2,
          "maxLength": 250
        },
        "igUrl": {
          "type": "string",
          "description": "Instagram profile or post URL",
          "maxLength": 300
        },
        "mapsUrl": {
          "type": "string",
          "description": "Google Maps, Apple Maps, or web mapping link",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": [
        "name",
        "lat",
        "lng",
        "address",
        "igUrl",
        "mapsUrl"
      ]
    },
    "promoter": {
      "title": "Promoter",
      "description": "An indie concert promoter or collective organizing live events",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the promoter or collective",
          "minLength": 2,
          "maxLength": 100
        },
        "igUrl": {
          "type": "string",
          "description": "Instagram profile link",
          "maxLength": 300
        },
        "verified": {
          "type": "boolean",
          "description": "Whether the promoter is verified"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": [
        "name",
        "igUrl",
        "verified"
      ]
    },
    "event": {
      "title": "Event",
      "description": "A livehouse or indie concert event in Bangkok / Rangsit",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title of the show or concert",
          "minLength": 2,
          "maxLength": 150
        },
        "artists": {
          "type": "array",
          "description": "List of performing artists/bands",
          "items": {
            "type": "string"
          }
        },
        "venueId": {
          "type": "string",
          "description": "ID of the host venue in /venues"
        },
        "promoterId": {
          "type": "string",
          "description": "ID of the organizing promoter in /promoters"
        },
        "startAt": {
          "type": "string",
          "format": "date-time",
          "description": "Event start date and time timestamp"
        },
        "priceText": {
          "type": "string",
          "description": "Ticket price description",
          "maxLength": 80
        },
        "genres": {
          "type": "array",
          "description": "Music genres/tags",
          "items": {
            "type": "string"
          }
        },
        "ticketUrl": {
          "type": "string",
          "description": "Ticket buying link",
          "maxLength": 500
        },
        "igPostUrl": {
          "type": "string",
          "description": "Instagram announcement post link",
          "maxLength": 500
        },
        "posterUrl": {
          "type": "string",
          "description": "Optional concert poster image URL",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": [
            "not_open",
            "available",
            "low",
            "sold_out",
            "cancelled"
          ],
          "description": "Ticket availability or show status"
        },
        "statusUpdatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the last status update"
        },
        "statusSource": {
          "type": "string",
          "enum": [
            "admin",
            "organizer"
          ],
          "description": "Source of status verification"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": [
        "title",
        "artists",
        "venueId",
        "promoterId",
        "startAt",
        "priceText",
        "genres",
        "ticketUrl",
        "igPostUrl",
        "status",
        "statusUpdatedAt",
        "statusSource"
      ]
    },
    "report": {
      "title": "Crowd Report",
      "description": "A user-reported ticket availability status for an event",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "available",
            "low",
            "sold_out"
          ],
          "description": "User reported ticket status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the report"
        }
      },
      "required": [
        "status",
        "createdAt"
      ]
    },
    "organizerRequest": {
      "title": "Organizer Application Request",
      "description": "Application from a user to become a verified promoter organizer",
      "type": "object",
      "properties": {
        "promoterName": {
          "type": "string",
          "description": "Name of the promoter collective",
          "minLength": 2,
          "maxLength": 100
        },
        "igUrl": {
          "type": "string",
          "description": "Official Instagram URL of the promoter",
          "maxLength": 300
        },
        "contactEmail": {
          "type": "string",
          "description": "Contact email address",
          "maxLength": 150
        },
        "note": {
          "type": "string",
          "description": "Verification instructions or proof note",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ],
          "description": "Status of the application request"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": [
        "promoterName",
        "igUrl",
        "contactEmail",
        "note",
        "status",
        "createdAt"
      ]
    },
    "organizer": {
      "title": "Approved Organizer Record",
      "description": "Record linking a verified user UID to their managed promoter ID",
      "type": "object",
      "properties": {
        "promoterId": {
          "type": "string",
          "description": "ID of the promoter managed by this user"
        },
        "email": {
          "type": "string",
          "description": "Email of the approved organizer",
          "maxLength": 150
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when approved by admin"
        }
      },
      "required": [
        "promoterId",
        "email",
        "approvedAt"
      ]
    }
  },
  "firestore": {
    "/venues/{venueId}": {
      "schema": "venue",
      "description": "Collection of indie / livehouse concert venues in Bangkok and Pathum Thani"
    },
    "/promoters/{promoterId}": {
      "schema": "promoter",
      "description": "Collection of indie concert promoters and collectives"
    },
    "/events/{eventId}": {
      "schema": "event",
      "description": "Collection of upcoming livehouse shows and concerts"
    },
    "/events/{eventId}/reports/{uid}": {
      "schema": "report",
      "description": "User crowd-reported ticket status for an event"
    },
    "/organizerRequests/{uid}": {
      "schema": "organizerRequest",
      "description": "User applications for verified organizer status"
    },
    "/organizers/{uid}": {
      "schema": "organizer",
      "description": "Active organizers mapped to their promoter IDs"
    }
  }
}
